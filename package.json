{
  "name": "lead-crm",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "node build_deploy.js",
    "install-all": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "axios-retry": "^4.5.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "imap": "^0.8.19",
    "imapflow": "^1.2.18",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.6",
    "mongoose": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "socket.io": "^4.6.2",
    "twilio": "^5.13.1",
    "uuid": "^9.0.1"
  }
}
